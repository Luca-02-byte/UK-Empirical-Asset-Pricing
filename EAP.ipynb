      "source": [
        "def grs_test(y_cols, f_cols):\n",
        "    T, N, L = len(df), len(y_cols), len(f_cols)\n",
        "    X = sm.add_constant(df[f_cols])\n",
        "    alfe, residui = [], []\n",
        "    for c in y_cols:\n",
        "        res = sm.OLS(df[c], X).fit()\n",
        "        alfe.append(res.params[\"const\"])\n",
        "        residui.append(res.resid)\n",
        "    a = np.array(alfe)                                          # vettore delle N alfa\n",
        "    E = np.column_stack(residui)                                # matrice T x N dei residui\n",
        "    Sigma = E.T @ E / (T - L - 1)                               # covarianza dei residui",
        "    mu = df[f_cols].mean().values                               # medie dei fattori\n",
        "    Omega = np.atleast_2d(np.cov(df[f_cols].values, rowvar=False, ddof=0))   # covarianza dei fattori",
        "    grs = (T / N) * ((T - N - L) / (T - L - 1)) * (a @ np.linalg.inv(Sigma) @ a) / (1 + mu @ np.linalg.inv(Omega) @ mu)\n",
        "    p = stats.f.sf(grs, N, T - N - L)\n",
        "    return grs, p\n",
        "\n",
        "tabella_grs = []\n",
        "for nome, fattori in modelli.items():\n",
        "    grs, p = grs_test(XSz, fattori)\n",
        "    gdl2 = len(df) - len(XSz) - len(fattori)\n",
        "    tabella_grs.append({\"model\": nome, \"GRS\": grs, \"p-value\": p,\n",
        "                        \"crit. 5%\": stats.f.ppf(0.95, len(XSz), gdl2),   
        "                        \"mean |alpha| %\": alfa[nome].abs().mean() * 100,\n",
        "                        \"avg adj R2\": r2adj[nome].mean()})\n",
        "tabella_grs = pd.DataFrame(tabella_grs).set_index(\"model\")\n",
        "print(tabella_grs.round(3))\n"
      ]
    },
