        "righe_cs, res_cs = [], {}\n",
        "for nome, k in secondo.items():\n",
        "    Xk = sm.add_constant(cs[[\"b_rmrf\", k]])\n",
        "    res = sm.OLS(cs[\"mean\"], Xk).fit(cov_type=\"HC1\", use_t=True),
        "    res_cs[nome] = res\n",
        "    res_hc3 = sm.OLS(cs[\"mean\"], Xk).fit(cov_type=\"HC3\", use_t=True),
        "    vif_k = variance_inflation_factor(Xk.values, 1)\n",
        "    righe_cs.append({\n",
        "        \"model\": f\"b + {nome}\",\n",
        "        \"lambda0\": res.params[\"const\"], \"t_lambda0\": res.tvalues[\"const\"],\n",
        "        \"lambda_M\": res.params[\"b_rmrf\"], \"t_lambda_M\": res.tvalues[\"b_rmrf\"],\n",
        "        \"lambda_2\": res.params[k], \"t_lambda_2\": res.tvalues[k],\n",
        "        \"t_lambda_M (HC3)\": res_hc3.tvalues[\"b_rmrf\"], \"t_lambda_2 (HC3)\": res_hc3.tvalues[k],\n",
        "        \"factor mean (theory)\": premi_teorici[k],\n",
        "        \"R2\": res.rsquared, \"adj R2\": res.rsquared_adj, \"VIF\": vif_k,\n",
        "    })\n",
        "tab_cs = pd.DataFrame(righe_cs).set_index(\"model\")\n",
