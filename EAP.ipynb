        "def descrittive(cols):\n",
        "    T = len(df)\n",
        "    tab = pd.DataFrame({\n",
        "        \"mean\": df[cols].mean(),\n",
        "        \"st.dev\": df[cols].std(),\n",
        "        \"t(mean)\": df[cols].mean() / (df[cols].std() / np.sqrt(T)),\n",
        "        \"Sharpe (annual)\": df[cols].mean() / df[cols].std() * np.sqrt(12),\n",
        "        \"skewness\": [stats.skew(df[c]) for c in cols],\n",
        "        \"kurtosis\": [stats.kurtosis(df[c], fisher=False) for c in cols],\n",
        "        \"min\": df[cols].min(),\n",
        "        \"max\": df[cols].max(),\n",
        "    })\n",
        "    tab.index = [f\"S{i}\" for i in range(1, 11)]\n",
        "    return tab\n",
        "\n",
        "desc_raw = descrittive(XS)\n",
        "desc_win = descrittive(XSz)\n",
        "print(\"RAW\\n\", desc_raw.round(4))\n",
        "print(\"WINSORIZED 2/98\\n\", desc_win.round(4))"
      ]
    },
