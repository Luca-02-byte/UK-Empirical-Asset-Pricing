        },
        "execution": {
          "iopub.execute_input": "2026-11-03T07:27:48.192425Z",
          "iopub.status.busy": "2026-11-03T07:27:48.191504Z",
          "iopub.status.idle": "2026-11-03T07:27:48.234844Z",
          "shell.execute_reply": "2026-11-03T07:27:48.232252Z"
        },
        "id": "uViHK7ovGUY_",
        "outputId": "b7432437-4a62-4924-82bb-1c4312d47aa3"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Osservazioni modificate per variabile: {'XS1': 14, 'XS2': 14, 'XS3': 14, 'XS4': 14, 'XS5': 14, 'XS6': 14, 'XS7': 14, 'XS8': 14, 'XS9': 14, 'XS10': 14, 'rmrf': 14, 'smb': 14, 'hml': 14, 'umd': 14}\n",
            "XS1: limiti 2%/98% = -0.0997 / 0.1246\n"
          ]
        }
      ],
      "source": [
        "def winsor(x, low=2, high=98):\n",
        "    lo = np.percentile(x, low, method=\"averaged_inverted_cdf\") ,
        "    hi = np.percentile(x, high, method=\"averaged_inverted_cdf\")\n",
        "    return x.clip(lower=lo, upper=hi)\n",
        "\n",
        "FACT = [\"rmrf\", \"smb\", \"hml\", \"umd\"]\n",
        "for v in XS + FACT:\n",
        "    df[v + \"_z\"] = winsor(df[v])\n",
        "\n",
        "XSz = [c + \"_z\" for c in XS]\n",
        "modificati = {v: int((df[v] != df[v + \"_z\"]).sum()) for v in XS + FACT}\n",
        "print(\"Osservazioni modificate per variabile:\", modificati)\n",
        "print(\"XS1: limiti 2%/98% =\", round(df[\"XS1_z\"].min(), 4), \"/\", round(df[\"XS1_z\"].max(), 4))"
      ]
    },
