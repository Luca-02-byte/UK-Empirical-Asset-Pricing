        "           \"Carhart 4F\": [\"rmrf_z\", \"smb_z\", \"hml_z\", \"umd_z\"]}\n",
        "\n",
        "r2 = pd.DataFrame(index=ts.index)       # R2 semplice\n",
        "r2adj = pd.DataFrame(index=ts.index)    # R2 corretto (adjusted): da usare nel confronto tra modelli\n",
        "alfa = pd.DataFrame(index=ts.index)\n",
        "for nome, fattori in modelli.items():\n",
        "    Xm = sm.add_constant(df[fattori])\n",
        "    for i in range(1, 11):\n",
        "        res = sm.OLS(df[f\"XS{i}_z\"], Xm).fit()\n",
        "        r2.loc[f\"S{i}\", nome] = res.rsquared\n",
        "        r2adj.loc[f\"S{i}\", nome] = res.rsquared_adj\n",
        "        alfa.loc[f\"S{i}\", nome] = res.params[\"const\"]\n",
        "\n",
        "print(\"R2 semplice\")\n",
        "print(r2.round(3))\n",
        "print(\"R2 corretto (adjusted)\")\n",
        "print(r2adj.round(3))\n",
        "print(\"Media |alfa| (% al mese):\")\n",
